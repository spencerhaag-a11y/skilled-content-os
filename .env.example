# ── Frontend (Vite) ─────────────────────────────────────────────
# Safe to expose to the browser. Copy to .env.local and fill in.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Drive import (Google Picker). ALL THREE must be browser-side — the
# Picker reads them in the page, so a value kept only in Supabase secrets is
# unreachable. None is sensitive: restrict the API key by HTTP referrer in
# Cloud Console.
#
# VITE_GOOGLE_APP_ID is the Cloud project NUMBER (not the project ID/name) —
# Cloud Console › Home › Project info. Drive import uses the drive.file scope,
# which grants access only to files the user actually picks, and Google attaches
# that grant to this app ID. If it is missing or belongs to a different project
# than the OAuth client, picking appears to work and every download 404s.
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-picker-developer-key
VITE_GOOGLE_APP_ID=your-cloud-project-number

# ── Supabase Edge Function secrets ──────────────────────────────
# NEVER put these in any VITE_ variable or client code.
# Set via: supabase secrets set KEY=value
# ANTHROPIC_API_KEY=          Claude API — all content generation (claude-sonnet-4-6)
# ASSEMBLYAI_API_KEY=         Video/audio transcription (Module 8)
# ASSEMBLYAI_WEBHOOK_SECRET=  Shared secret AssemblyAI echoes back to video-webhook (any random string)
# SERVICE_ROLE_KEY=           Service-role key for video-webhook (Supabase blocks the SUPABASE_ prefix on custom secrets)
# (GHL API keys are stored per-account in the database, encrypted — Section 6)
#
# GOOGLE_CLIENT_SECRET is NOT used yet. Drive import uses a browser-held access
# token per session, so there is no server-side code exchange. It becomes
# relevant only if a persistent "connect once" Drive connection is added — and
# while the OAuth app is External + Testing, Google expires refresh tokens after
# 7 days, so that flow needs app verification first.
